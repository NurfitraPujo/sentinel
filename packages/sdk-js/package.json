{
  "name": "@sentinel/sdk-js",
  "version": "0.0.0",
  "description": "Sentinel error-tracking SDK for JavaScript/TypeScript: browser, node and edge entries, a Next.js adapter, a tunnel route handler, the sentinel-sourcemaps CLI and the withSentinelConfig build wrapper",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuju-ai/sentinel.git",
    "directory": "packages/sdk-js"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/core/index.js",
    "./browser": "./dist/browser.js",
    "./node": "./dist/node.js",
    "./edge": "./dist/edge.js",
    "./nextjs/client": "./dist/nextjs/client.js",
    "./nextjs/server": "./dist/nextjs/server.js",
    "./nextjs/edge": "./dist/nextjs/edge.js",
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "browser": "./dist/nextjs/client.js",
      "edge-light": "./dist/nextjs/edge.js",
      "worker": "./dist/nextjs/edge.js",
      "workerd": "./dist/nextjs/edge.js",
      "node": "./dist/nextjs/server.js",
      "default": "./dist/nextjs/server.js"
    },
    "./nextjs/route": "./dist/nextjs/route.js",
    "./nextjs/config": "./dist/nextjs/config.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "sentinel-sourcemaps": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "check:no-dependencies": "node scripts/assert-no-dependencies.mjs"
  },
  "peerDependencies": {
    "next": ">=15.4",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
