# Sentinel — example environment configuration
#
# Copy to `.env` and adjust for local development. Values below are placeholders,
# never real secrets. This file documents every environment variable actually
# read by the four services in this repo (grep source: `os.Getenv` in
# apps/ingestor-go, apps/processor-go, packages/shared-go; `$env/dynamic/private`
# usage in apps/dashboard-web/src); it is not generated from a framework
# convention, so keep it in sync by hand when a new var is introduced.
#
# `docker-compose.yml` sets its own values for container-to-container
# networking (e.g. POSTGRES_HOST=postgres, NATS_URL=nats://nats:4222); this
# file is for running services directly on the host, and for reference.

# ---------------------------------------------------------------------------
# Postgres — read by apps/ingestor-go, apps/processor-go, apps/dashboard-web
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sentinel

# ---------------------------------------------------------------------------
# NATS JetStream — read by apps/ingestor-go, apps/processor-go
# ---------------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# ---------------------------------------------------------------------------
# Redis — read by apps/ingestor-go (rate limiter + API-key cache, S10)
# ---------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# apps/ingestor-go/middleware/ratelimit.go — when "true", rate limiter fails
# CLOSED (rejects) instead of failing open if Redis is unreachable.
RATELIMIT_STRICT_MODE=false

# ---------------------------------------------------------------------------
# packages/db-migrations/cmd/migrate — one DSN per target, selected by
# `-target <name>`. All three point at the same database in this single-
# postgres-instance compose setup; the migrations directory is flat and
# applies identically regardless of which DSN was used to connect (see
# ARCHITECTURE.md A1).
# ---------------------------------------------------------------------------
DB_URL_PROCESSOR=postgres://sentinel:changeme@localhost:5432/sentinel?sslmode=disable
DB_URL_INGESTOR=postgres://sentinel:changeme@localhost:5432/sentinel?sslmode=disable
DB_URL_DASHBOARD=postgres://sentinel:changeme@localhost:5432/sentinel?sslmode=disable

# ---------------------------------------------------------------------------
# Dashboard (apps/dashboard-web) — Drizzle DB connection
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://sentinel:changeme@localhost:5432/sentinel

# ---------------------------------------------------------------------------
# Dashboard — Auth.js (@auth/sveltekit), read by src/lib/server/auth-config.ts
# and required by the SvelteKitAuth() runtime itself
# ---------------------------------------------------------------------------
# AUTH_SECRET is required for Auth.js to start at all (session/JWT signing).
# Generate a real one with: openssl rand -base64 33
AUTH_SECRET=dev-only-insecure-secret-change-me-please-32chars
# Canonical origin used to build callback/redirect URLs.
AUTH_URL=http://localhost:3000
# auth-config.ts sets `trustHost: true` programmatically; setting this too
# keeps behavior consistent if that ever changes.
AUTH_TRUST_HOST=true

# Google OAuth provider — optional. Leave both blank to disable the provider
# entirely (auth-config.ts only registers it when both are set). Sign-in is
# additionally restricted to the "company.com" email domain (hardcoded).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (magic-link) provider — optional. Leave blank to disable. Use
# `smtp://debug` for local dev: auth-config.ts detects that prefix and swaps
# in a jsonTransport (logs the email instead of sending it) rather than
# opening a real SMTP connection.
EMAIL_SERVER=smtp://debug
EMAIL_FROM=noreply@sentinel.local

# ---------------------------------------------------------------------------
# Dashboard — settings encryption, read by src/lib/server/settings.ts
# ---------------------------------------------------------------------------
# Used to encrypt/decrypt stored per-project settings (e.g. notifier
# credentials). Must be a real secret in any non-throwaway environment.
SETTINGS_ENCRYPTION_KEY=default-long-and-secure-key-32-chars

# ---------------------------------------------------------------------------
# Dashboard — cron routes, read by src/routes/api/cron/retention/+server.ts
# ---------------------------------------------------------------------------
# Shared secret the retention cron caller must present.
CRON_SECRET=dev-only-cron-secret-change-me
# How many days of data the retention job keeps before deleting.
DATA_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Processor — outbound webhook delivery dispatcher (apps/processor-go/webhooks, N3b)
# ---------------------------------------------------------------------------
# Off by default. Set to "true" to start the dispatcher goroutine in main.go.
WEBHOOK_DISPATCH_ENABLED=false
# How often the dispatcher polls agent_webhooks for due events (Go duration string).
WEBHOOK_DISPATCH_INTERVAL=5s
# Consecutive delivery failures before a webhook's status flips to 'failed'.
WEBHOOK_FAILURE_THRESHOLD=20

# ---------------------------------------------------------------------------
# Processor — 'occurrence_burst' discovery event throttle (N7a)
# ---------------------------------------------------------------------------
# Minimum seconds between 'occurrence_burst' issue_activity rows for the same issue.
OCCURRENCE_EVENT_MIN_INTERVAL_SECONDS=3600
