# Sentinel — example environment configuration
#
# Copy to `.env` and adjust for local development. Values below are placeholders,
# never real secrets. This file documents every environment variable actually
# read by the four services in this repo (grep source: `os.Getenv` in
# apps/ingestor-go, apps/processor-go, packages/shared-go; `$env/dynamic/private`
# usage in apps/dashboard-web/src); it is not generated from a framework
# convention, so keep it in sync by hand when a new var is introduced.
#
# `docker-compose.yml` sets its own values for container-to-container
# networking (e.g. POSTGRES_HOST=postgres, NATS_URL=nats://nats:4222); this
# file is for running services directly on the host, and for reference.

# ---------------------------------------------------------------------------
# Postgres — read by apps/ingestor-go, apps/processor-go, apps/dashboard-web
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sentinel

# ---------------------------------------------------------------------------
# NATS JetStream — read by apps/ingestor-go, apps/processor-go
# ---------------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# ---------------------------------------------------------------------------
# Redis — read by apps/ingestor-go (rate limiter + API-key cache, S10)
# ---------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# apps/ingestor-go/middleware/ratelimit.go — when "true", rate limiter fails
# CLOSED (rejects) instead of failing open if Redis is unreachable.
RATELIMIT_STRICT_MODE=false

# ---------------------------------------------------------------------------
# packages/db-migrations/cmd/migrate — one DSN per target, selected by
# `-target <name>`. All three point at the same database in this single-
# postgres-instance compose setup; the migrations directory is flat and
# applies identically regardless of which DSN was used to connect (see
# ARCHITECTURE.md A1).
# ---------------------------------------------------------------------------
DB_URL_PROCESSOR=postgres://sentinel:changeme@localhost:5432/sentinel?sslmode=disable
DB_URL_INGESTOR=postgres://sentinel:changeme@localhost:5432/sentinel?sslmode=disable
DB_URL_DASHBOARD=postgres://sentinel:changeme@localhost:5432/sentinel?sslmode=disable

# ---------------------------------------------------------------------------
# Dashboard (apps/dashboard-web) — Drizzle DB connection
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://sentinel:changeme@localhost:5432/sentinel

# ---------------------------------------------------------------------------
# Dashboard — Auth.js (@auth/sveltekit), read by src/lib/server/auth-config.ts
# and required by the SvelteKitAuth() runtime itself
# ---------------------------------------------------------------------------
# AUTH_SECRET is required for Auth.js to start at all (session/JWT signing).
# Generate a real one with: openssl rand -base64 33
AUTH_SECRET=dev-only-insecure-secret-change-me-please-32chars
# Canonical origin used to build callback/redirect URLs.
AUTH_URL=http://localhost:3000
# auth-config.ts sets `trustHost: true` programmatically; setting this too
# keeps behavior consistent if that ever changes.
AUTH_TRUST_HOST=true

# Google OAuth provider — optional. Leave both blank to disable the provider
# entirely (auth-config.ts only registers it when both are set). Sign-in is
# additionally restricted to the "company.com" email domain (hardcoded).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (magic-link) provider — optional. Leave blank to disable. Use
# `smtp://debug` for local dev: auth-config.ts detects that prefix and swaps
# in a jsonTransport (logs the email instead of sending it) rather than
# opening a real SMTP connection.
EMAIL_SERVER=smtp://debug
EMAIL_FROM=noreply@sentinel.local

# ---------------------------------------------------------------------------
# Dashboard — settings encryption, read by src/lib/server/settings.ts
# ---------------------------------------------------------------------------
# Used to encrypt/decrypt stored per-project settings (e.g. notifier
# credentials). Must be a real secret in any non-throwaway environment.
SETTINGS_ENCRYPTION_KEY=default-long-and-secure-key-32-chars

# ---------------------------------------------------------------------------
# Dashboard — repo-credentials master key (N10), read by
# src/lib/server/repo-credential-crypto.ts
# ---------------------------------------------------------------------------
# AES-256-GCM master key for the encrypted git-credentials store: base64 of
# EXACTLY 32 random bytes (generate with `openssl rand -base64 32`). Without
# it the server refuses to store or serve repo credentials (503) — there is
# deliberately no fallback value in code. The value below is a known dev key;
# NEVER use it outside a throwaway environment. Rotating it requires the old
# key to stay available under its key_version until rows are re-encrypted.
SENTINEL_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktNC1zZW50aW5lbCE=

# ---------------------------------------------------------------------------
# Dashboard — cron routes, read by src/routes/api/cron/retention/+server.ts
# ---------------------------------------------------------------------------
# Shared secret the retention cron caller must present.
CRON_SECRET=dev-only-cron-secret-change-me
# How many days of data the retention job keeps before deleting.
DATA_RETENTION_DAYS=30
# N7c (A04): second, longer cutoff for occurrence-less MANUAL issues (issueType='user_report') --
# they never accumulate errorOccurrences rows by construction, so gating them on the short
# DATA_RETENTION_DAYS above would delete a still-relevant manual issue purely for being manual.
# Only resolved/ignored, unclaimed manual issues past this cutoff are ever deleted.
MANUAL_ISSUE_RETENTION_DAYS=365
# N7c (A03): how old an agent's claim (claimed_at) must be, with no recent activity from the
# claimant, before the retention cron's stale-claim reaper force-releases it.
CLAIM_STALE_HOURS=24
# N7f (R1b): how long an agent key stays valid (via expires_at) after POST /api/agent/key/rotate
# mints its replacement -- unlike the human rotateApiKey (immediate revoke), self-rotation keeps
# the old key usable for this grace window so an unattended agent mid-task isn't broken by its
# own rotation. 0 = immediate expiry (same effect as the human path).
AGENT_KEY_ROTATION_GRACE_HOURS=24
# N9 (C13): fallback lifetime (in days) for the NEW key minted by POST /api/agent/key/rotate when
# the rotated key had no expires_at to inherit. Unset/empty => the new key also stays non-expiring
# (backward-compatible). Set to a positive integer to force every rotation of a legacy
# never-expiring agent key onto a finite lifetime from then on. Keys that already carry an
# expires_at inherit their own original lifetime (expires_at - created_at) and ignore this.
AGENT_KEY_ROTATION_DEFAULT_DAYS=

# ---------------------------------------------------------------------------
# Processor — outbound webhook delivery dispatcher (apps/processor-go/webhooks, N3b)
# ---------------------------------------------------------------------------
# Off by default. Set to "true" to start the dispatcher goroutine in main.go.
WEBHOOK_DISPATCH_ENABLED=false
# How often the dispatcher polls agent_webhooks for due events (Go duration string).
WEBHOOK_DISPATCH_INTERVAL=5s
# Consecutive delivery failures before a webhook's status flips to 'failed'.
WEBHOOK_FAILURE_THRESHOLD=20

# ---------------------------------------------------------------------------
# Processor — 'occurrence_burst' discovery event throttle (N7a)
# ---------------------------------------------------------------------------
# Minimum seconds between 'occurrence_burst' issue_activity rows for the same issue.
OCCURRENCE_EVENT_MIN_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# sentinel-cron — scheduled POST /api/cron/retention (N9, contract correction C11).
# Ships gated OFF in docker-compose.yml (docker-compose.yml's sentinel-cron service). A stack with
# no scheduler running leaks stale agent claims (CLAIM_STALE_HOURS) and never applies retention
# windows -- flip RETENTION_CRON_ENABLED=true once you have decided on a schedule. These were
# missing from this file even though compose/DEPLOYMENT.md already documented them (plan §9 N8g row).
# ---------------------------------------------------------------------------
RETENTION_CRON_ENABLED=false
RETENTION_CRON_INTERVAL_SECONDS=3600
RETENTION_CRON_URL=http://dashboard:3000/api/cron/retention
RETENTION_CRON_TIMEOUT_SECONDS=30
# Days an issue_deleted tombstone is retained on the agent events feed before pruning (D20/C14);
# consumed by the dashboard retention route (apps/dashboard-web), not by the cron container.
# Matches the route's code default when unset.
TOMBSTONE_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# sentinel-worker — the continuous agent (N8, docs/plans/AGENT_WORKER_PLAN.md). Ships gated OFF in
# docker-compose.yml's sentinel-worker service; ALL of the three gates below must be flipped to
# "true", in order, before it does anything (see DEPLOYMENT.md's enable ladder). Full surface is
# documented at tools/sentinel-worker/main.go's LoadConfig; only the deployment-relevant subset is
# listed here.
# ---------------------------------------------------------------------------
SENTINEL_URL=http://dashboard:3000
SENTINEL_AGENT_KEY=
# --- gates: all three must be explicitly opted into for the worker to do anything ---
WORKER_ENABLED=false
WORKER_EXECUTE=false
WORKER_FIX_ENABLED=false
# --- loop tuning (compose defaults match the code's own fallbacks) ---
WORKER_POLL_INTERVAL=10s
WORKER_SWEEP_INTERVAL=1h
WORKER_BACKFILL_HOURS=24
WORKER_CONCURRENCY=2
# --- volume caps (plan §7; all read-and-enforced, each exposes a *_remaining metric gauge as of N8j) ---
# WORKER_DAILY_TOKEN_BUDGET: max Advisor LLM tokens/day (0 = unlimited). Seeded from the journal so
# "per day" survives a restart. Gauge: budget_remaining.
WORKER_DAILY_TOKEN_BUDGET=0
# Per-hour Advisor-call caps (0 = unlimited), seeded from the journal so a crash-loop within one UTC
# hour cannot reset them. Gauges: triage_per_hour_remaining / followup_per_hour_remaining.
WORKER_MAX_TRIAGE_PER_HOUR=60
WORKER_MAX_FOLLOWUP_PER_HOUR=60
# FIX volume caps. WORKER_MAX_FIX_ATTEMPTS is per-issue (resets at UTC midnight; crash-resumes are NOT
# re-counted as of N8j). Per-project MaxPRsPerDay arrives via server agentSettings (C15), not here.
# Gauges: fix_jobs_remaining / prs_remaining.
WORKER_MAX_FIX_ATTEMPTS=2
# --- LLM: no default provider ships here -- an operator must supply one before enabling ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# --- FIX executor (plan §4.4); empty means FIX never runs even if WORKER_FIX_ENABLED=true ---
FIX_EXECUTOR_CMD=
# WORKER_FIX_EXECUTOR_ENV (fix-lifecycle remediation round 2, finding 4): comma/newline list of
# KEY=VALUE or bare KEY entries passed through to $FIX_EXECUTOR_CMD's own child env -- the ONLY
# channel it has for its own model credential (e.g. droid's DeepSeek BYOK key). A forbidden key
# (SENTINEL_AGENT_KEY, any LLM_*_API_KEY, any git provider token) is rejected at startup, never
# passed through. Example: WORKER_FIX_EXECUTOR_ENV=DEEPSEEK_API_KEY=sk-...
WORKER_FIX_EXECUTOR_ENV=
# --- keyguard credential lifecycle (plan §2.5) ---
WORKER_KEYSTORE=file
# --- snapshots (plan §2.8; no PVC -- S3 snapshots are the durability story) ---
WORKER_SNAPSHOT_BACKEND=none
WORKER_SNAPSHOT_INTERVAL=5m
