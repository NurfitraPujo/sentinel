    "params": [
      "p-1",
      "p-2",
      "staging",
    ],
    "sql": "select cast(count(DISTINCT "issues"."id") as integer) from "issues" inner join "error_occurrences" on "error_occurrences"."issue_id" = "issues"."id" inner join "error_search_index" on "error_search_index"."occurrence_id" = "error_occurrences"."id" where ("issues"."project_id" in ($1, $2) and "error_occurrences"."environment" = $3)",
  },
]
`;

